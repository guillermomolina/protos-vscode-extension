// LM009-B lexical fixture: valid source forms only.

if: 1
else: 2
class: 3
function: 4

decimal: 1_000
fraction: 12.5
scientific: 6.022e23
binary: 0b1010_0101
octal: 0o755
hexadecimal: 0xDEAD_BEEF

single: 'single\nquoted'
doubleQuoted: "double\tquoted"
multiline: """
    line one
    line two with \"quoted\" content
    """

truth: true
absence: null
receiver: this
arguments: args
current: context

object: {
    nested: { value: false }
}
object.true: "member names after dot remain ordinary"
object.null: null

readReservedMember: object.true
readNullMember: object.null

double: x => x * 2
sum: (a, b) => {
    a + b
}

withRest: (first, ...rest) => rest

composed: {
    ...object
    label: "composed"
}

/* block comments may span
   logical source newlines */
identity: object === object
lazy: truth && false
notTruth: !truth

// BUG002: args is an ordinary identifier in every name position.
args: [1, 2, 3]
argsIdentity: (args) => args
argsRest: (...args) => args
memberArgs: object.args

// Contextual spellings are not reserved words.
for: (value) => value
in: "ordinary identifier"
return: 3
memberFor: object.for
memberReturn: object.return
memberElse: object.else

// Unicode identifiers and ordinary member names.
café: 42
unicodeMember: object.λ

// Range and InvertedRange are ordinary Core bindings.
ascending: Range(0, 4)
descending: Range(4, 0)
rangePrototype: Range
invertedPrototype: InvertedRange

// each and eachStep are ordinary selectors.
ordinaryEach: args.each(item => { item })
ordinaryStep: ascending.eachStep(2, i => { i })
descendingEach: descending.each(i => { i })

// Contextual for: generic, numeric and stepped descending.
genericFor: for(item in args) { item }
numericFor: for(i, 0, 4) { i }
steppedFor: for(i, 4, 0, -2) { i }

// Contextual return is a non-local return, not a keyword.
withReturn: (value) => {
    return value
}

// Existing contextual control forms remain ordinary words.
conditional: if(truth) { true } else { false }
whileCheck: while(false) { null }
postTest: { true } until(true)

// Fixed bitwise spellings.
bitAndValue: 12 & 10
bitOrValue: 12 | 10
bitXorValue: 12 ~ 10
bitNotValue: ~0
leftShiftValue: 1 << 8
rightShiftValue: 16 >> 2
nestedBitwise: 12 ~ ~10

// These spellings inside strings are never source operators.
textualSyntax: "for(i in values) { return ~i }"
