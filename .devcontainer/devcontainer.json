{
    "name": "Protos VS Code Extension",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    // Docker:
    // "runArgs": ["--userns=host"],
    // Podman rootless:
    "runArgs": [
        "--userns=keep-id:uid=1000,gid=1000",
        "--shm-size=1g"
    ],
    "remoteUser": "node",
    "updateRemoteUserUID": false,
    "postCreateCommand": "npm ci",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.vscode-json",
                "dbaeumer.vscode-eslint"
            ]
        }
    }
}